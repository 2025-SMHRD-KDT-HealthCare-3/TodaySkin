# Python (venv/ 용량 큼)
venv/
__pycache__/
*.pyc
*.pyo

# 환경변수 (API 키, DB 비밀번호 - 절대 올리면 안됨!)
.env

# Mac 시스템 파일
.DS_Store

# YOLO 모델 파일 (용량 커서 제외)
*.pt
*.pth

# node_modules 폴더는 무시
node_modules/

# sessions 폴더
2.Backend_node/sessions/

# 실시간으로 처리된 이미지가 저장되는 uploads 폴더 내부 파일은 무시하되
uploads/*

# .gitkeep 파일만은 예외로 두어 폴더 구조를 유지함
!uploads/.gitkeep

# 화장품 벡터 DB (서버 시작 시 자동 생성되므로 Git 관리 불필요)
3.Ai_FastAPI\services\chroma_cosm_db